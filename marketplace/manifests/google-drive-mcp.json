{
  "$schema": "../schema/connector-manifest.schema.json",
  "id": "google-drive-mcp",
  "name": "Google Drive (Read-Only · Personal Mode)",
  "version": "1.0.0",
  "description": "Google's official stateless Streamable HTTP MCP server for Google Drive on the free Standard Tier (Personal Mode OAuth). Search and inspect Drive files on demand.",
  "platforms": ["macos"],
  "transport": {
    "type": "mcp_streamable_http",
    "baseUrl": "https://drivemcp.googleapis.com/mcp/v1"
  },
  "auth": {
    "type": "oauth2_pkce",
    "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
    "tokenEndpoint": "https://oauth2.googleapis.com/token",
    "redirectUri": "http://127.0.0.1:48912/callback",
    "scopes": [
      "https://www.googleapis.com/auth/drive.readonly"
    ],
    "setupFields": [
      {
        "key": "client_id",
        "label": "Google Cloud OAuth Desktop Client ID (Personal Mode)",
        "secret": false,
        "required": true,
        "placeholder": "1234567890-abc.apps.googleusercontent.com"
      },
      {
        "key": "client_secret",
        "label": "Google OAuth Client Secret (Optional)",
        "secret": true,
        "required": false,
        "placeholder": "GOCSPX-..."
      }
    ]
  },
  "permissions": [
    "drive.readonly"
  ],
  "tools": [
    {
      "name": "search_files",
      "description": "Search and inspect Google Drive files and folders on demand via Google's official stateless MCP server.",
      "requiresApproval": false
    }
  ],
  "signature": {
    "algorithm": "ed25519",
    "keyId": "brokbot-marketplace-dev-2026",
    "value": "unsigned-starter-template"
  }
}
